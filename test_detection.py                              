from ultralytics import YOLO
import cv2

# Load pretrained YOLOv8 model (downloads automatically first time, ~6MB)
model = YOLO('yolov8n.pt')

# Open the video file
video_path = 'data/test1.mp4'
cap = cv2.VideoCapture(video_path)

if not cap.isOpened():
    print("ERROR: Could not open video. Check the path.")
    exit()

while cap.isOpened():
    ret, frame = cap.read()
    if not ret:
        break  # video ended

    # classes=[0,2,3,5,7] = person, car, motorcycle, bus, truck
    results = model(frame, classes=[0, 2, 3, 5, 7], verbose=False)

    annotated_frame = results[0].plot()
    cv2.imshow('Detection Test', annotated_frame)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
