# ============================================================
# SELECT RESTRICTED AREA
# ============================================================

def select_polygon(
    video_path
):

    global polygon_points

    polygon_points = []


    cap = cv2.VideoCapture(
        video_path
    )


    if not cap.isOpened():

        raise RuntimeError(

            f"Could not open video: "
            f"{video_path}"

        )


    success, frame = cap.read()

    cap.release()


    if not success:

        raise RuntimeError(
            "Could not read video."
        )


    window_name = (
        "IBVAP - DRAW RESTRICTED AREA"
    )


    cv2.namedWindow(

        window_name,

        cv2.WINDOW_NORMAL

    )


    cv2.setMouseCallback(

        window_name,

        mouse_callback

    )


    print()
    print("=" * 65)
    print("IBVAP - CUSTOM RESTRICTED AREA")
    print("=" * 65)
    print()
    print("LEFT CLICK  = Add point")
    print("RIGHT CLICK = Remove point")
    print("R           = Reset")
    print("ENTER       = Confirm")
    print("ESC         = Cancel")
    print()


    while True:

        display = frame.copy()


        # ====================================================
        # DRAW POINTS
        # ====================================================

        for index, point in enumerate(
            polygon_points
        ):

            cv2.circle(

                display,

                point,

                7,

                COLOR_YELLOW,

                -1

            )


            cv2.putText(

                display,

                str(index + 1),

                (
                    point[0] + 10,
                    point[1] - 10
                ),

                cv2.FONT_HERSHEY_SIMPLEX,

                0.6,

                COLOR_YELLOW,

                2

            )


        # ====================================================
        # DRAW LINES
        # ====================================================

        if len(polygon_points) >= 2:

            pts = np.array(

                polygon_points,

                dtype=np.int32

            )


            cv2.polylines(

                display,

                [pts],

                False,

                COLOR_RED,

                3

            )


        # ====================================================
        # DRAW FILLED POLYGON
        # ====================================================

        if len(polygon_points) >= 3:

            pts = np.array(

                polygon_points,

                dtype=np.int32

            )


            overlay = display.copy()


            cv2.fillPoly(

                overlay,

                [pts],

                COLOR_RED

            )


            display = cv2.addWeighted(

                overlay,

                0.20,

                display,

                0.80,

                0

            )


            cv2.polylines(

                display,

                [pts],

                True,

                COLOR_RED,

                4

            )


        # ====================================================
        # INSTRUCTION PANEL
        # ====================================================

        cv2.rectangle(

            display,

            (10, 10),

            (620, 120),

            (0, 0, 0),

            -1

        )


        instructions = [

            "LEFT CLICK: Add Point",

            "RIGHT CLICK: Undo Point",

            "R: Reset",

            "ENTER: Confirm | ESC: Cancel"

        ]


        for index, text in enumerate(
            instructions
        ):

            cv2.putText(

                display,

                text,

                (
                    20,
                    35 + index * 23
                ),

                cv2.FONT_HERSHEY_SIMPLEX,

                0.55,

                COLOR_WHITE,

                1

            )


        cv2.imshow(

            window_name,

            display

        )


        key = cv2.waitKey(
            20
        ) & 0xFF


        # RESET
        if key == ord("r"):

            polygon_points.clear()

            print(
                "Polygon reset."
            )


        # ENTER
        elif key in (13, 10):

            if len(polygon_points) >= 3:

                print(
                    "Polygon confirmed."
                )

                break

            else:

                print(
                    "Select at least 3 points."
                )


        # ESC
        elif key == 27:

            cv2.destroyAllWindows()

            return None


    cv2.destroyAllWindows()

    return polygon_points.copy()


# ============================================================
# MAIN DETECTION
# ============================================================

def run_detection(

    video_path=DEFAULT_VIDEO_PATH,

    fence_points=None,

    output_path=DEFAULT_OUTPUT_PATH,

    camera_id=CAMERA_ID

):


    # ========================================================
    # VALIDATE FENCE
    # ========================================================

    if (

        not fence_points

        or

        len(fence_points) < 3

    ):

        raise ValueError(
            "At least 3 fence points required."
        )


    # ========================================================
    # INITIALIZE DATABASE
    # ========================================================

    init_db()

    initialize_csv()


    # ========================================================
    # LOAD DETECTION MODEL
    # ========================================================

    print()
    print("Loading detection model...")


    model = YOLO(
        MODEL_PATH
    )


    print(
        "Detection model loaded!"
    )


    # ========================================================
    # LOAD POSE MODEL
    # ========================================================

    print(
        "Loading pose estimation model..."
    )


    pose_model = YOLO(
        POSE_MODEL_PATH
    )


    print(
        "Pose estimation model loaded!"
    )


    # ========================================================
    # OPEN VIDEO
    # ========================================================

    cap = cv2.VideoCapture(
        video_path
    )


    if not cap.isOpened():

        raise RuntimeError(

            f"Could not open video: "
            f"{video_path}"

        )


    width = int(

        cap.get(
            cv2.CAP_PROP_FRAME_WIDTH
        )

    )


    height = int(

        cap.get(
            cv2.CAP_PROP_FRAME_HEIGHT
        )

    )


    fps = cap.get(
        cv2.CAP_PROP_FPS
    )


    if fps <= 0:

        fps = 25.0


    # ========================================================
    # POLYGON
    # ========================================================

    polygon_array = np.array(

        fence_points,

        dtype=np.int32

    )


    # ========================================================
    # OUTPUT
    # ========================================================

    output_dir = os.path.dirname(
        output_path
    )


    if output_dir:

        os.makedirs(

            output_dir,

            exist_ok=True

        )


    fourcc = cv2.VideoWriter_fourcc(
        *"mp4v"
    )


    out = cv2.VideoWriter(

        output_path,

        fourcc,

        fps,

        (
            width,
            height
        )

    )


    # ========================================================
    # RE-ID SETTINGS
    # ========================================================

    LOST_MEMORY_FRAMES = int(
        fps * 5
    )

    REID_DISTANCE = 150


    # ========================================================
    # VARIABLES
    # ========================================================

    centroid_history = {}

    behavior_history = {}

    # Temporal confirmation state for suspicious activity
    suspicion_history = {}

    track_to_logical = {}

    logical_intruders = {}

    next_logical_id = 1

    event_number = 0

    # Separate counter for confirmed suspicious-activity events
    suspicious_event_number = 0

    frame_number = 0

    events = []


    # Alert cooldown
    last_global_alert = 0

    ALERT_COOLDOWN = 3.0


    # ========================================================
    # WINDOW
    # ========================================================

    live_window_name = (
        "IBVAP - AI BORDER SURVEILLANCE"
    )


    cv2.namedWindow(

        live_window_name,

        cv2.WINDOW_NORMAL

    )


    print()
    print("=" * 65)
    print("LIVE DETECTION STARTED")
    print("=" * 65)
    print()
    print("Features Active:")
    print("- Object Detection")
    print("- ByteTrack")
    print("- Human Pose Skeleton")
    print("- Virtual Fence")
    print("- Intrusion Detection")
    print("- Behavioral Analytics")
    print("- Sound Alerts")
    print()
    print("Press Q to stop.")
    print()


    # ========================================================
    # PROCESS VIDEO
    # ========================================================

    while True:


        success, frame = cap.read()


        if not success:

            break


        frame_number += 1


        # ====================================================
        # OBJECT DETECTION + TRACKING
        # ====================================================

        results = model.track(

            frame,

            persist=True,

            classes=DETECTION_CLASSES,

            tracker="bytetrack.yaml",

            verbose=False

        )


        boxes = results[0].boxes


        # ====================================================
        # POSE ESTIMATION
        # ====================================================

        pose_results = pose_model(

            frame,

            verbose=False

        )


        pose_boxes = None

        pose_keypoints = None

        pose_confidences = None


        if len(pose_results) > 0:


            pose_result = pose_results[0]


            if (

                pose_result.boxes is not None

                and

                pose_result.keypoints is not None

            ):


                pose_boxes = (

                    pose_result.boxes.xyxy

                    .cpu()

                    .numpy()

                )


                pose_keypoints = (

                    pose_result.keypoints.xy

                    .cpu()

                    .numpy()

                )


                if (

                    pose_result.keypoints.conf

                    is not None

                ):

                    pose_confidences = (

                        pose_result.keypoints.conf

                        .cpu()

                        .numpy()

                    )


        # ====================================================
        # CURRENT FRAME VARIABLES
        # ====================================================

        current_intrusions = set()

        current_logical_intrusions = set()

        # Confirmed suspicious persons in the current frame
        current_suspicious_logicals = set()

        current_objects = {}

        matched_logicals_this_frame = set()


        # ====================================================
        # DRAW RESTRICTED ZONE
        # ====================================================

        overlay = frame.copy()


        cv2.fillPoly(

            overlay,

            [polygon_array],

            COLOR_RED

        )


        frame = cv2.addWeighted(

            overlay,

            0.12,

            frame,

            0.88,

            0

        )


        cv2.polylines(

            frame,

            [polygon_array],

            True,

            COLOR_RED,

            4

        )


        cv2.putText(

            frame,

            "RESTRICTED ZONE",

            (20, 125),

            cv2.FONT_HERSHEY_SIMPLEX,

            0.8,

            COLOR_RED,

            2

        )


        # ====================================================
        # PROCESS TRACKED OBJECTS
        # ====================================================

        if (

            boxes is not None

            and

            boxes.id is not None

        ):


            coordinates = (

                boxes.xyxy

                .cpu()

                .numpy()

            )


            track_ids = (

                boxes.id

                .cpu()

                .numpy()

                .astype(int)

            )


            class_ids = (

                boxes.cls

                .cpu()

                .numpy()

                .astype(int)

            )


            confidences = (

                boxes.conf

                .cpu()

                .numpy()

            )


            # =================================================
            # EACH OBJECT
            # =================================================

            for (

                box,
                track_id,
                class_id,
                confidence

            ) in zip(

                coordinates,

                track_ids,

                class_ids,

                confidences

            ):


                # =============================================
                # BOUNDING BOX
                # =============================================

                x1, y1, x2, y2 = map(

                    int,

                    box

                )


                bbox = (

                    x1,
                    y1,
                    x2,
                    y2

                )


                # =============================================
                # CATEGORY
                # =============================================

                category = CATEGORY_NAMES.get(

                    class_id,

                    "object"

                )


                display_name = DISPLAY_NAMES.get(

                    class_id,

                    "OBJECT"

                )


                # =============================================
                # CENTROID
                # =============================================

                center_x = (

                    x1 + x2

                ) // 2


                center_y = (

                    y1 + y2

                ) // 2


                centroid = (

                    center_x,

                    center_y

                )


                # =============================================
                # FIND MATCHING HUMAN POSE
                # =============================================

                matched_pose = None

                person_keypoints = None

                person_pose_confidences = None


                if class_id == 0:


                    matched_pose = find_matching_pose(

                        bbox,

                        pose_boxes,

                        pose_keypoints,

                        pose_confidences

                    )


                    if matched_pose is not None:


                        person_keypoints = (

                            matched_pose[
                                "keypoints"
                            ]

                        )


                        person_pose_confidences = (

                            matched_pose[
                                "confidences"
                            ]

                        )


                # =============================================
                # CHECK INTRUSION
                # =============================================

                if class_id == 0:


                    inside_zone = check_pose_intrusion(

                        polygon_array,

                        person_keypoints,

                        person_pose_confidences,

                        centroid

                    )


                else:


                    result = cv2.pointPolygonTest(

                        polygon_array,

                        centroid,

                        False

                    )


                    inside_zone = (
                        result >= 0
                    )


                # =============================================
                # BEHAVIORAL ANALYTICS
                # =============================================

                suspicious_behaviors = []


                if class_id == 0:


                    suspicious_behaviors = analyze_behavior(

                        track_id,

                        centroid,

                        bbox,

                        person_keypoints,

                        person_pose_confidences,

                        behavior_history,

                        fps

                    )


                # Raw frame-level suspicion
                is_suspicious = (

                    len(
                        suspicious_behaviors
                    ) > 0

                )


                # =============================================
                # TEMPORAL SMOOTHING / FALSE ALERT FILTER
                # =============================================

                suspicion_result = update_suspicion_state(

                    track_id,

                    suspicious_behaviors,

                    suspicion_history,

                    window_size=12,

                    confirm_frames=7

                )


                confirmed_suspicious = (

                    suspicion_result["confirmed"]

                )


                suspicious_score = (

                    suspicion_result["score"]

                )


                confirmed_behaviors = (

                    suspicion_result["confirmed_behaviors"]

                )


                # =============================================
                # LOGICAL ID
                # =============================================

                logical_id = (

                    track_to_logical.get(
                        track_id
                    )

                )


                if logical_id is None:


                    logical_id = find_matching_intruder(

                        centroid,

                        category,

                        frame_number,

                        logical_intruders,

                        LOST_MEMORY_FRAMES,

                        REID_DISTANCE,

                        matched_logicals_this_frame

                    )


                    if logical_id is not None:


                        matched_logicals_this_frame.add(
                            logical_id
                        )


                    else:


                        logical_id = (
                            next_logical_id
                        )


                        next_logical_id += 1


                    track_to_logical[
                        track_id
                    ] = logical_id


                # =============================================
                # PREVIOUS STATE
                # =============================================

                old_info = logical_intruders.get(

                    logical_id,

                    {}

                )


                was_inside = old_info.get(

                    "inside",

                    False

                )


                crossed_into_zone = (

                    not was_inside

                    and

                    inside_zone

                )


                # =============================================
                # UPDATE LOGICAL OBJECT
                # =============================================

                logical_intruders[
                    logical_id
                ] = {

                    "category":
                        category,

                    "last_centroid":
                        centroid,

                    "last_seen_frame":
                        frame_number,

                    "inside":
                        inside_zone,

                    "event_created":
                        old_info.get(
                            "event_created",
                            False
                        )

                }


                # =============================================
                # CURRENT OBJECT
                # =============================================

                current_objects[
                    track_id
                ] = {

                    "category":
                        category,

                    "confidence":
                        float(confidence),

                    "centroid":
                        centroid,

                    "logical_id":
                        logical_id

                }


                # =============================================
                # INTRUSION
                # =============================================

                if inside_zone:


                    current_intrusions.add(
                        track_id
                    )


                    current_logical_intrusions.add(
                        logical_id
                    )


                # =============================================
                # CONFIRMED SUSPICIOUS PERSON
                # =============================================

                if confirmed_suspicious:

                    current_suspicious_logicals.add(
                        logical_id
                    )


                # =============================================
                # DRAW TRAIL
                # =============================================

                if track_id not in (
                    centroid_history
                ):

                    centroid_history[
                        track_id
                    ] = deque(
                        maxlen=30
                    )


                centroid_history[
                    track_id
                ].append(
                    centroid
                )


                trail = centroid_history[
                    track_id
                ]


                if len(trail) >= 2:


                    for i in range(

                        1,

                        len(trail)

                    ):


                        cv2.line(

                            frame,

                            trail[
                                i - 1
                            ],

                            trail[
                                i
                            ],

                            COLOR_MAGENTA,

                            2

                        )


                # =============================================
                # DETERMINE BOX COLOR
                # =============================================

                # Intrusion always has highest priority
                if inside_zone:


                    box_color = COLOR_RED


                # Confirmed suspicious activity flashes red
                elif confirmed_suspicious:


                    if (frame_number // 8) % 2 == 0:

                        box_color = COLOR_RED

                    else:

                        box_color = COLOR_ORANGE


                # Raw suspicion is shown but does not trigger alarm yet
                elif is_suspicious:


                    box_color = COLOR_ORANGE


                else:


                    box_color = COLOR_GREEN


                # =============================================
                # DRAW BOX
                # =============================================

                cv2.rectangle(

                    frame,

                    (
                        x1,
                        y1
                    ),

                    (
                        x2,
                        y2
                    ),

                    box_color,

                    3

                )


                # =============================================
                # DRAW CENTROID
                # =============================================

                cv2.circle(

                    frame,

                    centroid,

                    6,

                    COLOR_MAGENTA,

                    -1

                )


                # =============================================
                # DRAW ACTUAL POSE SKELETON
                # =============================================

                if (

                    class_id == 0

                    and

                    person_keypoints is not None

                    and

                    person_pose_confidences is not None

                ):


                    draw_skeleton(

                        frame,

                        person_keypoints,

                        person_pose_confidences

                    )


                # =============================================
                # MAIN LABEL
                # =============================================

                if inside_zone:


                    label = (

                        f"INTRUDER | "
                        f"ID:{logical_id}"

                    )


                elif confirmed_suspicious:


                    label = (

                        f"CONFIRMED SUSPICIOUS | "
                        f"ID:{logical_id}"

                    )


                elif is_suspicious:


                    label = (

                        f"ANALYZING ACTIVITY | "
                        f"ID:{logical_id}"

                    )


                else:


                    label = (

                        f"{display_name} | "
                        f"ID:{logical_id}"

                    )


                cv2.putText(

                    frame,

                    label,

                    (

                        x1,

                        max(
                            y1 - 15,
                            30
                        )

                    ),

                    cv2.FONT_HERSHEY_SIMPLEX,

                    0.7,

                    box_color,

                    2

                )


                # =============================================
                # CONFIDENCE
                # =============================================

                cv2.putText(

                    frame,

                    f"Confidence: {confidence:.2f}",

                    (

                        x1,

                        min(
                            y2 + 25,
                            height - 20
                        )

                    ),

                    cv2.FONT_HERSHEY_SIMPLEX,

                    0.5,

                    COLOR_WHITE,

                    2

                )


                # =============================================
                # DISPLAY BEHAVIOR
                # =============================================

                if is_suspicious:


                    display_behaviors = (

                        confirmed_behaviors

                        if (
                            confirmed_suspicious
                            and confirmed_behaviors
                        )

                        else suspicious_behaviors

                    )


                    behavior_text = " | ".join(

                        display_behaviors

                    )


                    cv2.putText(

                        frame,

                        behavior_text,

                        (

                            x1,

                            min(
                                y2 + 50,
                                height - 5
                            )

                        ),

                        cv2.FONT_HERSHEY_SIMPLEX,

                        0.5,

                        COLOR_ORANGE,

                        2

                    )


                    cv2.putText(

                        frame,

                        f"Suspicion Score: {suspicious_score:.0%}",

                        (

                            x1,

                            min(
                                y2 + 75,
                                height - 5
                            )

                        ),

                        cv2.FONT_HERSHEY_SIMPLEX,

                        0.45,

                        COLOR_YELLOW,

                        1

                    )


                # =============================================
                # CROSSING MESSAGE
                # =============================================

                if crossed_into_zone:


                    cv2.putText(

                        frame,

                        "CROSSED VIRTUAL FENCE!",

                        (

                            x1,

                            max(
                                y1 - 45,
                                25
                            )

                        ),

                        cv2.FONT_HERSHEY_SIMPLEX,

                        0.6,

                        COLOR_RED,

                        2

                    )


                # =============================================
                # SOUND ALERT
                # =============================================

                current_time = time.time()


                # Sound alert only for intrusion or temporally
                # CONFIRMED suspicious activity (not one-frame noise)
                should_alert = (

                    inside_zone

                    or

                    confirmed_suspicious

                )


                if (

                    should_alert

                    and

                    current_time
                    -
                    last_global_alert

                    >
                    ALERT_COOLDOWN

                ):


                    play_alert_sound()


                    last_global_alert = (
                        current_time
                    )


                # =============================================
                # CREATE CONFIRMED SUSPICIOUS ACTIVITY EVENT
                # =============================================

                if confirmed_suspicious:

                    state = suspicion_history.get(
                        track_id,
                        {}
                    )

                    last_event_time = state.get(
                        "last_event",
                        0
                    )

                    # One event per person every 10 seconds
                    if current_time - last_event_time > 10.0:

                        suspicious_event_number += 1

                        state["last_event"] = current_time

                        now = datetime.now()

                        date_string = now.strftime(
                            "%Y-%m-%d"
                        )

                        time_string = now.strftime(
                            "%H:%M:%S"
                        )

                        snapshot_name = (
                            f"suspicious_{suspicious_event_number:04d}.jpg"
                        )

                        snapshot_path = os.path.join(
                            SNAPSHOT_DIR,
                            snapshot_name
                        )

                        cv2.imwrite(
                            snapshot_path,
                            frame
                        )

                        behavior_for_log = (
                            " | ".join(confirmed_behaviors)
                            if confirmed_behaviors
                            else "SUSPICIOUS_ACTIVITY"
                        )

                        try:

                            log_event(

                                camera_id=camera_id,

                                object_type="person",

                                track_id=track_id,

                                event_type="suspicious_activity",

                                confidence=float(confidence),

                                snapshot_path=os.path.abspath(
                                    snapshot_path
                                )

                            )

                        except Exception as e:

                            print(
                                f"Suspicious activity database error: {e}"
                            )

                        with open(
                            LOG_FILE,
                            "a",
                            newline=""
                        ) as file:

                            writer = csv.writer(file)

                            writer.writerow([

                                date_string,

                                time_string,

                                track_id,

                                logical_id,

                                "person",

                                "SUSPICIOUS_ACTIVITY",

                                behavior_for_log,

                                f"{suspicious_score:.4f}",

                                center_x,

                                center_y,

                                os.path.abspath(
                                    snapshot_path
                                )

                            ])

                        events.append({

                            "camera_id": camera_id,

                            "track_id": track_id,

                            "logical_id": logical_id,

                            "category": "person",

                            "event": "SUSPICIOUS_ACTIVITY",

                            "behavior": behavior_for_log,

                            "confidence": float(
                                suspicious_score
                            ),

                            "snapshot": os.path.abspath(
                                snapshot_path
                            )

                        })


        # ====================================================
        # CREATE INTRUSION EVENTS
        # ====================================================

        for logical_id in (
            current_logical_intrusions
        ):


            intruder_info = logical_intruders.get(
                logical_id
            )


            if intruder_info is None:

                continue


            if intruder_info.get(
                "event_created",
                False
            ):

                continue


            event_number += 1


            intruder_info[
                "event_created"
            ] = True


            event_category = (
                intruder_info["category"]
            )


            event_centroid = (
                intruder_info["last_centroid"]
            )


            cx = event_centroid[0]

            cy = event_centroid[1]


            # Find current tracker ID
            current_track_id = None


            for tid, lid in (
                track_to_logical.items()
            ):


                if lid == logical_id:


                    current_track_id = tid

                    break


            confidence = 0.0


            if current_track_id is not None:


                object_info = current_objects.get(

                    current_track_id,

                    {}

                )


                confidence = object_info.get(

                    "confidence",

                    0.0

                )


            # =================================================
            # TIME
            # =================================================

            now = datetime.now()


            date_string = now.strftime(
                "%Y-%m-%d"
            )


            time_string = now.strftime(
                "%H:%M:%S"
            )


            # =================================================
            # SNAPSHOT
            # =================================================

            snapshot_name = (

                f"intrusion_{event_number:04d}.jpg"

            )


            snapshot_path = os.path.join(

                SNAPSHOT_DIR,

                snapshot_name

            )


            cv2.imwrite(

                snapshot_path,

                frame

            )


            # =================================================
            # DATABASE
            # =================================================

            database_status = "SUCCESS"


            try:


                log_event(

                    camera_id=camera_id,

                    object_type=event_category,

                    track_id=(

                        current_track_id

                        if current_track_id
                        is not None

                        else logical_id

                    ),

                    event_type="intrusion",

                    confidence=float(
                        confidence
                    ),

                    snapshot_path=os.path.abspath(
                        snapshot_path
                    )

                )


            except Exception as e:


                database_status = "FAILED"


                print(
                    f"Database error: {e}"
                )


            # =================================================
            # CSV
            # =================================================

            with open(

                LOG_FILE,

                "a",

                newline=""

            ) as file:


                writer = csv.writer(
                    file
                )


                writer.writerow([

                    date_string,

                    time_string,

                    current_track_id,

                    logical_id,

                    event_category,

                    "INTRUSION",

                    "CROSSED_RESTRICTED_ZONE",

                    f"{confidence:.4f}",

                    cx,

                    cy,

                    os.path.abspath(
                        snapshot_path
                    )

                ])


            # =================================================
            # STORE EVENT
            # =================================================

            events.append({

                "camera_id":
                    camera_id,

                "track_id":
                    current_track_id,

                "logical_id":
                    logical_id,

                "category":
                    event_category,

                "event":
                    "INTRUSION",

                "confidence":
                    float(confidence),

                "snapshot":
                    os.path.abspath(
                        snapshot_path
                    ),

                "database_status":
                    database_status

            })


        # ====================================================
        # REMOVE EXPIRED OBJECTS
        # ====================================================

        expired_logical_ids = []


        for logical_id, info in (
            logical_intruders.items()
        ):


            frame_gap = (

                frame_number

                -

                info["last_seen_frame"]

            )


            if frame_gap > LOST_MEMORY_FRAMES:


                expired_logical_ids.append(
                    logical_id
                )


        for logical_id in (
            expired_logical_ids
        ):


            del logical_intruders[
                logical_id
            ]


        # ====================================================
        # STATUS
        # ====================================================

        active_intruders = len(
            current_logical_intrusions
        )


        active_suspicious = len(
            current_suspicious_logicals
        )


        if active_intruders > 0:


            cv2.putText(

                frame,

                "!!! INTRUSION DETECTED !!!",

                (20, 45),

                cv2.FONT_HERSHEY_SIMPLEX,

                0.9,

                COLOR_RED,

                3

            )


            cv2.putText(

                frame,

                f"Active Intruders: {active_intruders}",

                (20, 80),

                cv2.FONT_HERSHEY_SIMPLEX,

                0.65,

                COLOR_RED,

                2

            )


        elif active_suspicious > 0:


            alert_text = "!!! SUSPICIOUS ACTIVITY DETECTED !!!"

            if (frame_number // 8) % 2 == 0:

                cv2.putText(

                    frame,

                    alert_text,

                    (20, 45),

                    cv2.FONT_HERSHEY_SIMPLEX,

                    0.9,

                    COLOR_RED,

                    3

                )


            cv2.putText(

                frame,

