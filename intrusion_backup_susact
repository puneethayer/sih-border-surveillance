# ============================================================
# DISTANCE FUNCTION
# ============================================================

def calculate_distance(
    point1,
    point2
):

    return math.sqrt(

        (point1[0] - point2[0]) ** 2

        +

        (point1[1] - point2[1]) ** 2

    )


# ============================================================
# IOU FUNCTION
# ============================================================

def calculate_iou(
    box_a,
    box_b
):

    ax1, ay1, ax2, ay2 = box_a

    bx1, by1, bx2, by2 = box_b


    x1 = max(
        ax1,
        bx1
    )

    y1 = max(
        ay1,
        by1
    )

    x2 = min(
        ax2,
        bx2
    )

    y2 = min(
        ay2,
        by2
    )


    intersection_width = max(
        0,
        x2 - x1
    )

    intersection_height = max(
        0,
        y2 - y1
    )


    intersection = (

        intersection_width

        *

        intersection_height

    )


    area_a = max(
        0,
        ax2 - ax1
    ) * max(
        0,
        ay2 - ay1
    )


    area_b = max(
        0,
        bx2 - bx1
    ) * max(
        0,
        by2 - by1
    )


    union = (

        area_a

        +

        area_b

        -

        intersection

    )


    if union <= 0:

        return 0.0


    return intersection / union


# ============================================================
# FIND MATCHING POSE
# ============================================================

def find_matching_pose(
    person_box,
    pose_boxes,
    pose_keypoints,
    pose_confidences
):

    if (
        pose_boxes is None
        or
        pose_keypoints is None
    ):

        return None


    best_index = None

    best_iou = 0.0


    for index, pose_box in enumerate(
        pose_boxes
    ):

        iou = calculate_iou(
            person_box,
            pose_box
        )

        if iou > best_iou:

            best_iou = iou

            best_index = index


    if best_index is None:

        return None


    # Minimum overlap requirement
    if best_iou < 0.10:

        return None


    return {

        "keypoints":
            pose_keypoints[
                best_index
            ],

        "confidences":
            pose_confidences[
                best_index
            ]

    }


# ============================================================
# DRAW HUMAN SKELETON
# ============================================================

def draw_skeleton(
    frame,
    keypoints,
    confidences,
    confidence_threshold=0.35
):

    if keypoints is None:

        return


    # ========================================================
    # DRAW SKELETON CONNECTIONS
    # ========================================================

    for start_index, end_index in (
        SKELETON_CONNECTIONS
    ):

        if (
            start_index >= len(keypoints)
            or
            end_index >= len(keypoints)
        ):

            continue


        if (
            confidences[start_index]
            < confidence_threshold
            or
            confidences[end_index]
            < confidence_threshold
        ):

            continue


        point1 = (

            int(
                keypoints[start_index][0]
            ),

            int(
                keypoints[start_index][1]
            )

        )


        point2 = (

            int(
                keypoints[end_index][0]
            ),

            int(
                keypoints[end_index][1]
            )

        )


        cv2.line(

            frame,

            point1,

            point2,

            COLOR_YELLOW,

            3

        )


    # ========================================================
    # DRAW KEYPOINTS
    # ========================================================

    for index, point in enumerate(
        keypoints
    ):

        if index >= len(confidences):

            continue


        if (
            confidences[index]
            < confidence_threshold
        ):

            continue


        x = int(
            point[0]
        )

        y = int(
            point[1]
        )


        cv2.circle(

            frame,

            (x, y),

            6,

            COLOR_YELLOW,

            -1

        )


# ============================================================
# CHECK HUMAN INTRUSION USING KEYPOINTS
# ============================================================

def check_pose_intrusion(
    polygon,
    keypoints,
    confidences,
    centroid,
    confidence_threshold=0.35
):

    # ========================================================
    # CHECK ACTUAL BODY KEYPOINTS
    # ========================================================

    if (
        keypoints is not None
        and
        confidences is not None
    ):

        for index, point in enumerate(
            keypoints
        ):

            if index >= len(confidences):

                continue


            if (
                confidences[index]
                < confidence_threshold
            ):

                continue


            body_point = (

                int(point[0]),

                int(point[1])

            )


            result = cv2.pointPolygonTest(

                polygon,

                body_point,

                False

            )


            # ANY BODY PART INSIDE
            if result >= 0:

                return True


    # ========================================================
    # FALLBACK TO CENTROID
    # ========================================================

    result = cv2.pointPolygonTest(

        polygon,

        centroid,

        False

    )


    return result >= 0


# ============================================================
# RE-ID FUNCTION
# ============================================================

def find_matching_intruder(

    centroid,
    category,
    frame_number,
    logical_intruders,
    lost_memory_frames,
    reid_distance,
    matched_logicals=None

):

    if matched_logicals is None:

        matched_logicals = set()


    best_match = None

    best_distance = float(
        "inf"
    )


    for logical_id, info in (
        logical_intruders.items()
    ):

        if logical_id in (
            matched_logicals
        ):

            continue


        frame_gap = (

            frame_number

            -

            info["last_seen_frame"]

        )


        if frame_gap > (
            lost_memory_frames
        ):

            continue


        if (
            info["category"]
            !=
            category
        ):

            continue


        old_centroid = (
            info["last_centroid"]
        )


        distance = calculate_distance(

            centroid,

            old_centroid

        )


        if (

            distance < reid_distance

            and

            distance < best_distance

        ):

            best_distance = distance

            best_match = logical_id


    return best_match


# ============================================================
# BEHAVIORAL ANALYTICS
# ============================================================

def analyze_behavior(

    track_id,
    centroid,
    bbox,
    keypoints,
    confidences,
    behavior_history,
    fps

):

    suspicious_behaviors = []


    x1, y1, x2, y2 = bbox

    box_width = max(
        1,
        x2 - x1
    )

    box_height = max(
        1,
        y2 - y1
    )


    # ========================================================
    # CREATE HISTORY
    # ========================================================

    if track_id not in (
        behavior_history
    ):

        behavior_history[
            track_id
        ] = {

            "positions":
                deque(
                    maxlen=int(
                        fps * 10
                    )
                ),

            "directions":
                deque(
                    maxlen=20
                ),

            "first_seen":
                time.time(),

            "last_alert":
                0

        }


    history = behavior_history[
        track_id
    ]


    positions = history[
        "positions"
    ]


    # ========================================================
    # STORE POSITION
    # ========================================================

    positions.append(

        (
            centroid,
            time.time()
        )

    )


    # ========================================================
    # RAPID MOVEMENT
    # ========================================================

    if len(positions) >= 2:

        previous_position = (
            positions[-2][0]
        )

        current_position = (
            positions[-1][0]
        )


        distance = calculate_distance(

            previous_position,

            current_position

        )


        normalized_speed = (

            distance * fps

        ) / box_height


        # Roughly > 1 body height/sec
        if normalized_speed > 1.2:

            suspicious_behaviors.append(
                "RAPID MOVEMENT"
            )


    # ========================================================
    # ERRATIC MOVEMENT
    # ========================================================

    if len(positions) >= 3:

        p1 = positions[-3][0]

        p2 = positions[-2][0]

        p3 = positions[-1][0]


        vector1 = (

            p2[0] - p1[0],

            p2[1] - p1[1]

        )


        vector2 = (

            p3[0] - p2[0],

            p3[1] - p2[1]

        )


        magnitude1 = math.sqrt(

            vector1[0] ** 2

            +

            vector1[1] ** 2

        )


        magnitude2 = math.sqrt(

            vector2[0] ** 2

            +

            vector2[1] ** 2

        )


        if (

            magnitude1 > 5

            and

            magnitude2 > 5

        ):

            dot_product = (

                vector1[0] * vector2[0]

                +

                vector1[1] * vector2[1]

            )


            cosine_angle = (

                dot_product

                /

                (
                    magnitude1
                    *
                    magnitude2
                )

            )


            cosine_angle = max(

                -1,

                min(
                    1,
                    cosine_angle
                )

            )


            angle = math.degrees(
                math.acos(
                    cosine_angle
                )
            )


            if angle > 100:

                history[
                    "directions"
                ].append(
                    angle
                )


    if len(
        history["directions"]
    ) >= 6:

        suspicious_behaviors.append(
            "ERRATIC MOVEMENT"
        )


    # ========================================================
    # LOITERING
    # ========================================================

    if len(positions) >= int(fps * 8):

        start_position = (
            positions[0][0]
        )

        current_position = (
            positions[-1][0]
        )


        displacement = calculate_distance(

            start_position,

            current_position

        )


        time_present = (

            positions[-1][1]

            -

            positions[0][1]

        )


        # Person remains approximately in same area
        if (

            time_present > 8

            and

            displacement < box_width * 1.5

        ):

            suspicious_behaviors.append(
                "LOITERING"
            )


    # ========================================================
    # POSE BASED ANALYSIS
    # ========================================================

    if (

        keypoints is not None

        and

        confidences is not None

        and

        len(keypoints) >= 17

    ):

        def valid(index):

            return (

                confidences[index]
                >=
                0.35

            )


        # ====================================================
        # RAISED HANDS
        # ====================================================

        if (

            valid(5)
            and
            valid(6)
            and
            valid(9)
            and
            valid(10)

        ):

            left_shoulder_y = (
                keypoints[5][1]
            )

            right_shoulder_y = (
                keypoints[6][1]
            )

            left_wrist_y = (
                keypoints[9][1]
            )

            right_wrist_y = (
                keypoints[10][1]
            )


            hands_up = (

                left_wrist_y
                <
                left_shoulder_y

                and

                right_wrist_y
                <
                right_shoulder_y

            )


            if hands_up:

                suspicious_behaviors.append(
                    "HANDS RAISED"
                )


        # ====================================================
        # CROUCHING
        # ====================================================

        if (

            valid(5)
            and
            valid(6)
            and
            valid(11)
            and
            valid(12)

        ):

            shoulder_y = (

                keypoints[5][1]

                +

                keypoints[6][1]

            ) / 2


            hip_y = (

                keypoints[11][1]

                +

                keypoints[12][1]

            ) / 2


            torso_height = (

                hip_y

                -

                shoulder_y

            )


            normalized_torso = (

                torso_height

                /

                box_height

            )


            if normalized_torso < 0.22:

                suspicious_behaviors.append(
                    "CROUCHING"
                )


    return list(
        set(
            suspicious_behaviors
        )
    )


# ============================================================
# TEMPORAL SUSPICIOUS ACTIVITY SMOOTHING
# ============================================================

def update_suspicion_state(
    track_id,
    suspicious_behaviors,
    suspicion_history,
    window_size=12,
    confirm_frames=7
):
    """
    Prevents one-frame false alarms by confirming suspicious
    behaviour only when it persists across multiple frames.
    """

    if track_id not in suspicion_history:

        suspicion_history[track_id] = {
            "frames": deque(maxlen=window_size),
            "behavior_counts": {},
            "confirmed": False,
            "last_event": 0
        }

    state = suspicion_history[track_id]

    raw_suspicious = len(suspicious_behaviors) > 0

    state["frames"].append({
        "suspicious": raw_suspicious,
        "behaviors": list(suspicious_behaviors)
    })

    # Count behaviour occurrences across the temporal window
    behavior_counts = {}

    for item in state["frames"]:

        if item["suspicious"]:

            for behavior in item["behaviors"]:

                behavior_counts[behavior] = (
                    behavior_counts.get(behavior, 0) + 1
                )

    state["behavior_counts"] = behavior_counts

    suspicious_frame_count = sum(
        1
        for item in state["frames"]
        if item["suspicious"]
    )

    # Confirm only after persistent evidence
    if suspicious_frame_count >= confirm_frames:

        state["confirmed"] = True

    # Release confirmation only after activity mostly disappears
    elif (
        state["confirmed"]
        and suspicious_frame_count <= 2
    ):

        state["confirmed"] = False

    temporal_score = (
        suspicious_frame_count / max(1, len(state["frames"]))
    )

    confirmed_behaviors = [
        behavior
        for behavior, count in behavior_counts.items()
        if count >= max(2, confirm_frames // 3)
    ]

    return {
        "confirmed": state["confirmed"],
        "score": temporal_score,
        "confirmed_behaviors": confirmed_behaviors,
        "suspicious_frames": suspicious_frame_count
    }


